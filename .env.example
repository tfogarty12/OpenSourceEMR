# Copy to .env for local development. NEVER commit a real .env or any PHI.

# API
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml dev defaults)
DATABASE_URL=postgres://osemr:osemr_dev_only@localhost:5432/osemr

# Auth (DEV ONLY): HS256 secret enabling /auth/dev-login and dev token
# verification. Generate a real one and NEVER use this value outside local dev.
# Production uses OIDC (RS256/JWKS) behind the TokenVerifier interface instead.
AUTH_DEV_SECRET=dev-secret-change-me
