{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "rootDir": "src",
    // React props routinely pass `undefined` for optional props; relax this one
    // strictness flag here (the rest of the strict config still applies).
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"]
}
